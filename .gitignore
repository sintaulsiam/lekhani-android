# ─── Rust / Cargo ─────────────────────────────────────────────────────────────
/target/
**/target/
Cargo.lock          # Lock file is tracked for binary crates, excluded here
                    # because lekhani-android is a library crate whose consumers
                    # (the Android Gradle build) manage their own lock files.
**/*.rs.bk

# ─── Android / Gradle ─────────────────────────────────────────────────────────
*.apk
*.aab
*.ap_
*.dex
*.class
local.properties
.gradle/
build/
captures/
.externalNativeBuild/
.cxx/
*.so                # Compiled native libs — always built from source, never committed.
gradle-daemon-jvm.properties

# ─── Android Studio / IntelliJ IDEA ───────────────────────────────────────────
.idea/
*.iws
*.iml
*.ipr
out/
.DS_Store

# ─── NDK / cargo-ndk artefacts ────────────────────────────────────────────────
jniLibs/
**/app/src/main/jniLibs/

# ─── UniFFI generated sources ─────────────────────────────────────────────────
# Generated Kotlin bindings are re-generated at build time from the Rust crate.
# Committing them causes spurious diffs on every Rust change.
**/app/src/main/java/com/lekhani/android/ffi/lekhani_android.kt

# ─── Generated asset staging ──────────────────────────────────────────────────
# src/main/assets/ is populated by the copyLekhaniAssets Gradle task at build time.
# Source of truth: lekhani-engine/data/ (shared) and lekhani-android/data/ (Android-only).
# Never commit staged assets — they are binary blobs that belong in the source data/ dirs.
**/app/src/main/assets/

# ─── OS noise ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*~

# ─── Editor / tooling ─────────────────────────────────────────────────────────
.vscode/
.env
*.log
AGENTS.md
*neural_weights*.json
